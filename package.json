{
  "name": "opencode-cursor-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode AI SDK provider backed by the Cursor TypeScript SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": ["dist", "README.md", "README-cn.md"],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:tsup": "tsup",
    "test": "tsx --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.0",
    "@cursor/sdk": "^1.0.24"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.5",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
